{
  "name": "jui-ui-vue",
  "version": "0.0.1",
  "private": true,
  "description": "jui-ui component library rewritten as native Vue 3 components (all 24 components)",
  "type": "module",
  "license": "MIT",
  "author": "search5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juijs-vue/jui-ui-vue.git",
    "directory": "vue"
  },
  "homepage": "https://github.com/juijs-vue/jui-ui-vue/tree/master/vue#readme",
  "bugs": {
    "url": "https://github.com/juijs-vue/jui-ui-vue/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "component-library"
  ],
  "main": "./dist/jui-ui-vue.umd.js",
  "module": "./dist/jui-ui-vue.es.js",
  "exports": {
    ".": {
      "import": "./dist/jui-ui-vue.es.js",
      "require": "./dist/jui-ui-vue.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "jui-core-ts": "file:../jui-core-ts",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.12.0",
    "jsdom": "^24.0.0",
    "less": "^3.13.1",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  }
}
